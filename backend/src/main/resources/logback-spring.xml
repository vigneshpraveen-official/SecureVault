<?xml version="1.0" encoding="UTF-8"?>
<!--
  P4.7/M-46,M-47. logs/ is gitignored (already, since S0.1) — never committed.
  %X{correlationId} pulls from the MDC that CorrelationIdFilter populates per request, so every
  line for a given request — across every logger, including background @Async work triggered
  from it — can be grepped out by one id (P4.6's threads log their own name too, in-message).
-->
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}" />
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{correlationId:-\-}] %logger{36} - %msg%n" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- SizeAndTimeBasedRollingPolicy: rolls daily OR at 10MB, whichever comes first, keeps 7
         days of history, and never lets the total archive exceed 200MB regardless of history
         length (the oldest files are deleted first once the cap is hit). -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/securevault.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/securevault.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- DEBUG locally (developer detail), INFO in prod (business events only) — per-profile,
         per P4.7's explicit instruction. -->
    <springProfile name="local">
        <logger name="com.securevault" level="DEBUG" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <springProfile name="prod">
        <logger name="com.securevault" level="INFO" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <springProfile name="!local &amp; !prod">
        <logger name="com.securevault" level="INFO" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>
</configuration>
