# --- database ---
DB_URL=jdbc:postgresql://localhost:5432/securevault   # JDBC URL for the local/target PostgreSQL instance
DB_USERNAME=postgres                                    # PostgreSQL role used by the app
DB_PASSWORD=                                            # PostgreSQL role password (never commit a real value)

# --- security ---
JWT_SECRET=                 # HS256 signing key, >= 32 bytes, base64 encoded (generate with: openssl rand -base64 32)
JWT_ACCESS_EXPIRY_MS=900000       # access token lifetime in ms (default 15 min, per D-08)
JWT_REFRESH_EXPIRY_MS=604800000   # refresh token lifetime in ms (default 7 days, per D-08)
AES_SECRET_KEY=              # AES-256-GCM master key, exactly 32 bytes, base64 encoded (generate with: openssl rand -base64 32)

# --- redis ---
REDIS_HOST=localhost         # Redis host (Docker service name in docker-compose)
REDIS_PORT=6379              # Redis port
REDIS_PASSWORD=              # Redis auth password, empty for local dev

# --- mail (optional until Phase 5) ---
MAIL_HOST=smtp.gmail.com     # SMTP host; MailHog is used locally instead (see docker-compose.yml)
MAIL_PORT=587                # SMTP port
MAIL_USERNAME=               # SMTP account username
MAIL_PASSWORD=               # Gmail app password, not the account password

# --- app ---
APP_CORS_ORIGINS=http://localhost:5173   # comma-separated list of allowed frontend origins
SERVER_PORT=8080                          # backend HTTP port
